 "sections": {
  "s1": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">TRACK RECORD</span><h2 class=\"section__title\">数字で見る、文理学部の進学力</h2><p class=\"section__lead\">文系（知日塾）・理系（知日理工）あわせて、累計 学部1,506名が合格。毎年、難関大学へ合格者を輩出しています。</p></div>\n    <div class=\"stats\">\n      <div class=\"stat\"><div class=\"num\">1,506<small>名</small></div><div class=\"lbl\">学部 累計合格</div></div>\n      <div class=\"stat\"><div class=\"num\">2<small>分野</small></div><div class=\"lbl\">文系・理系に対応</div></div>\n      <div class=\"stat\"><div class=\"num\">60<small>校+</small></div><div class=\"lbl\">合格・進学先大学</div></div>\n      <div class=\"stat\"><div class=\"num\">2013<small>〜</small></div><div class=\"lbl\">12年の指導実績</div></div>\n    </div>\n  </div>\n</section>",
  "s2": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">2 FIELDS</span><h2 class=\"section__title\">文系・理系、それぞれの専門指導</h2></div>\n    <div class=\"cards2\">\n      <div class=\"mini\"><h3>知日塾 ─ 文科学部</h3><p>法学・経済・経営・商・文・史学・教育・社会・国際・政治経済など。EJU文系科目から校内考の小論文・面接までを体系的に対策します。</p></div>\n      <div class=\"mini\"><h3>知日理工 ─ 理科学部</h3><p>理工・物理・情報・電気電子・建築・化学など。EJU理系科目と数学を軸に、専門基礎と校内考対策で理系名門校を狙います。</p></div>\n    </div>\n  </div>\n</section>",
  "s3": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">BY TIER</span><h2 class=\"section__title\">主な合格・進学先大学</h2><p class=\"section__lead\">国公立から私立難関まで、幅広いレンジに合格実績があります。</p></div>\n    <div class=\"uni-tiers\">\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">国公立</span><div class=\"uni-tier__c\"><span>大阪大学</span><span>東北大学</span><span>筑波大学</span><span>東京都立大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">早慶上理</span><div class=\"uni-tier__c\"><span>早稲田大学</span><span>慶應義塾大学</span><span>上智大学</span><span>東京理科大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">MARCH</span><div class=\"uni-tier__c\"><span>明治大学</span><span>立教大学</span><span>中央大学</span><span>法政大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">関関同立</span><div class=\"uni-tier__c\"><span>関西大学</span><span>関西学院大学</span><span>同志社大学</span><span>立命館大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">ほか</span><div class=\"uni-tier__c\"><span>日本大学</span><span>東洋大学</span><span>順天堂大学</span><span>明治学院大学</span><span>東京工科大学</span><span>大阪工業大学</span><span class=\"more-uni\">ほか 60校+</span></div></div>\n    </div>\n  </div>\n</section>",
  "s4": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">FACULTIES</span><h2 class=\"section__title\">幅広い学部・専攻に対応</h2></div>\n    <div class=\"brands\">\n      <span>法学部</span><span>経済学部</span><span>経営学部</span><span>商学部</span><span>文学部</span><span>史学</span>\n      <span>教育学</span><span>社会学</span><span>国際関係</span><span>政治経済</span>\n      <span>理工学部</span><span>物理学</span><span>情報</span><span>電気電子</span><span>建築</span><span>化学</span>\n    </div>\n  </div>\n</section>",
  "s5": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">VOICES</span><h2 class=\"section__title\">合格ストーリー</h2><p class=\"section__lead\">逆転合格・高得点合格まで。宣传册「文理学部 合格経験談」の全インタビューを掲載しています（氏名は非掲載）。</p></div>\n\n    <div class=\"section__head\" style=\"margin:0 auto 22px;max-width:none;\"><span class=\"eyebrow\">文系学部 ─ 知日塾</span></div>\n    <div class=\"cases\">\n      <div class=\"case\"><div class=\"case__meta\">2025年度｜国公立逆転</div><h3>国内大学を退学し、大阪大学 法学部へ「意外」合格</h3><div class=\"case__offers\"><span>大阪大学 法学部</span><span>EJU 日本語326</span><span>文総197</span><span>数学176</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2025年度｜実行力の勝利</div><h3>超・実行力で、明治大学 法学部に合格</h3><div class=\"case__offers\"><span>明治大学 法学部</span><span>EJU 日本語322+45</span><span>文総184</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜1年で逆転</div><h3>高考失敗から再起、1年で東北大学 法学部へ</h3><div class=\"case__offers\"><span>東北大学 法学部</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜欧米から赴日</div><h3>欧米のofferを断り、東京都立大学 学部へ</h3><div class=\"case__offers\"><span>東京都立大学</span><span>中央大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜三学部制覇</div><h3>慶應義塾大学、3学部のofferを獲得</h3><div class=\"case__offers\"><span>慶應義塾大学（3学部）</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜ダブルoffer</div><h3>法政・明治 法学部のダブルoffer（3千字の受験ノウハウ）</h3><div class=\"case__offers\"><span>法政大学 法学部</span><span>明治大学 法学部</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜学部ダブルoffer</div><h3>法政 経済学＋日本大学 教育学のダブルoffer</h3><div class=\"case__offers\"><span>法政大学 経済学部</span><span>日本大学 教育学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜専門学校から逆転</div><h3>専門学校から、7つのofferを掴んで慶應義塾へ</h3><div class=\"case__offers\"><span>慶應義塾大学</span><span>立命館大学</span><span>同志社大学</span><span>立教大学</span><span>法政大学</span><span>関西大学</span><span>関西学院大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜理転文</div><h3>理系から文系へ、立命館 経済学部のofferを獲得</h3><div class=\"case__offers\"><span>立命館大学 経済学部</span><span>大阪産業大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2022年度｜ゼロから芸術へ</div><h3>文系・ゼロから芸術学部へ、多摩美術大学 芸術学科に合格</h3><div class=\"case__offers\"><span>多摩美術大学 芸術学科</span><span>立命館大学</span><span>日本大学</span><span>明治大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2022年度｜MARCH史学</div><h3>高考失敗から赴日、MARCH 法政大学 史学専攻へ</h3><div class=\"case__offers\"><span>法政大学 史学</span></div></div>\n    </div>\n\n    <div class=\"section__head\" style=\"margin:44px auto 22px;max-width:none;\"><span class=\"eyebrow\">理系学部 ─ 知日理工</span></div>\n    <div class=\"cases\">\n      <div class=\"case\"><div class=\"case__meta\">2025年度｜社会人から再起</div><h3>2年かけて人生を再起動、上海の大学を休学し東京理科大学へ逆転</h3><div class=\"case__offers\"><span>東京理科大学</span><span>立命館大学</span><span>東洋大学</span><span>明治学院大学</span><span>法政大学</span><span>中央大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2025年度｜MARCH直行</div><h3>高考失敗からの再起、日大ではなくMARCHへ</h3><div class=\"case__offers\"><span>法政大学</span><span>明治学院大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2025年度｜国立合格</div><h3>筑波大学 理工学部に合格</h3><div class=\"case__offers\"><span>筑波大学 理工学部</span><span>東京理科大学</span><span>日本大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜偏科でも名門</div><h3>「偏った得意科目」を武器に、早稲田大学 理工学部へ</h3><div class=\"case__offers\"><span>早稲田大学 理工学部</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜半年で100点UP</div><h3>EJU日本語を半年で100点アップ、東京理科大学 物理学部へ</h3><div class=\"case__offers\"><span>東京理科大学 物理学部</span><span>日本大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2024年度｜1年で大量合格</div><h3>1年で8校に合格、理系学部の最速合格メソッド</h3><div class=\"case__offers\"><span>中央大学</span><span>立教大学</span><span>法政大学</span><span>関西大学</span><span>関西学院大学</span><span>同志社大学</span><span>立命館大学</span><span>順天堂大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜校内考で逆転</div><h3>東京工科大学に合格、校内考で「追い越し」</h3><div class=\"case__offers\"><span>東京工科大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜オンライン指導</div><h3>オンラインの全面指導で、大阪の夢校に合格</h3><div class=\"case__offers\"><span>大阪工業大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2023年度｜個別の伴走</div><h3>「個人」に寄り添う指導で、東京理科大学へ</h3><div class=\"case__offers\"><span>東京理科大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">2022年度｜高考数学満点</div><h3>高考数学 満点の実力で、早稲田大学 理工学部へ</h3><div class=\"case__offers\"><span>早稲田大学 理工学部</span><span>東京理科大学</span><span>同志社大学</span><span>関西学院大学</span></div></div>\n    </div>\n  </div>\n</section>",
  "s6": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">METHOD</span><h2 class=\"section__title\">日本の大学受験に特化した対策</h2><p class=\"section__lead\">中国の高考が「深さ」を問うのに対し、日本のEJUは知識の「広さ・体系」を問います。その違いに合わせて、合格までを設計します。</p></div>\n    <div class=\"cards3\">\n      <div class=\"mini\"><h3>EJU（日本留学試験）</h3><p>日本語・文総／数学・理科を、レベル別クラスと過去問演習で得点最大化。半年で大きく伸ばす指導例も。</p></div>\n      <div class=\"mini\"><h3>校内考・志望理由書</h3><p>大学ごとの校内考（小論文・専門）と志望理由書を、教授の研究関心まで踏まえて個別に対策します。</p></div>\n      <div class=\"mini\"><h3>面接・出願指導</h3><p>模擬面接で受け答えを反復練習。出願校の選定から書類まで、合格まで一貫して伴走します。</p></div>\n    </div>\n    <div class=\"flow__out\" style=\"max-width:880px;margin:34px auto 0;\">\n      個別担当制で、出願から合格まで深く寄り添う「<strong>データドリブン × 深い伴走</strong>」が、知日塾・知日理工の指導スタイルです。\n    </div>\n  </div>\n</section>",
  "s7": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"xlink\">\n      <div>\n        <h3>美術・ACG・音楽・スポーツも</h3>\n        <p>文理のほか、美術（CHIART）・ACG・音楽・スポーツまで、分野別の専門ブランドで進路を支援しています。</p>\n      </div>\n      <a href=\"/results/\" class=\"btn btn--white btn--lg\">合格実績の全体を見る</a>\n    </div>\n  </div>\n</section>",
  "s8": "<section class=\"cta-band\">\n  <div class=\"container\">\n    <h2>留学生の送り出し・進学提携をご検討の皆さまへ</h2>\n    <p>学部・年度別の詳細な合格実績は個別にご提供します。お気軽にご相談ください。</p>\n    <a href=\"/corporate/#contact\" class=\"btn btn--white btn--lg\">お問い合わせ・資料請求</a>\n  </div>\n</section>"
 },

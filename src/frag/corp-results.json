 "sections": {
  "s1": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">CHIART</span><h2 class=\"section__title\">知日美術 合格実績</h2><p class=\"section__lead\">2023〜2025年度、合格628枚。芸術系トップ校へ毎年合格者を輩出しています。</p></div>\n    <div class=\"stats\">\n      <div class=\"stat\"><div class=\"num\">628<small>枚</small></div><div class=\"lbl\">合格（2023〜2025年度）</div></div>\n      <div class=\"stat\"><div class=\"num\">96.3<small>%</small></div><div class=\"lbl\">学部 平均合格率</div></div>\n      <div class=\"stat\"><div class=\"num\">92.3<small>%</small></div><div class=\"lbl\">大学院 平均合格率</div></div>\n      <div class=\"stat\"><div class=\"num\">80<small>枚</small></div><div class=\"lbl\">トップ専門学校 合格</div></div>\n    </div>\n    <div class=\"flow__out\" style=\"max-width:760px;margin:34px auto 0;\">\n      内訳：<strong>東京御三家 77枚</strong>・<strong>東京五美 113枚</strong>・<strong>関西四美 199枚</strong>（※不完全統計）\n    </div>\n  </div>\n</section>",
  "s2": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">BY SCHOOL</span><h2 class=\"section__title\">主な美大別 合格数</h2></div>\n    <div class=\"unicount\">\n      <div class=\"u\"><b>5<small>枚</small></b><span>東京藝術大学</span></div>\n      <div class=\"u\"><b>49<small>枚</small></b><span>多摩美術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>武蔵野美術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>女子美術大学</span></div>\n      <div class=\"u\"><b>11<small>枚</small></b><span>日本大学 芸術学部</span></div>\n      <div class=\"u\"><b>45<small>枚</small></b><span>京都精華大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>京都芸術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>大阪芸術大学</span></div>\n      <div class=\"u\"><b>14<small>枚</small></b><span>成安造形大学</span></div>\n      <div class=\"u\"><b>7<small>枚</small></b><span>東京造形大学</span></div>\n    </div>\n  </div>\n</section>",
  "s3": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">FIELDS</span><h2 class=\"section__title\">幅広い専攻に対応</h2><p class=\"section__lead\">純芸術からデザイン・映像・服飾まで、専攻ごとの専門指導で合格へ導きます。</p></div>\n    <div class=\"brands\">\n      <span>イラストレーション</span><span>アニメーション</span><span>漫画</span><span>油画</span><span>彫刻</span>\n      <span>版画</span><span>グラフィックデザイン</span><span>プロダクトデザイン</span><span>ビジュアルデザイン</span>\n      <span>映像</span><span>写真</span><span>建築・空間デザイン</span><span>キャラクターデザイン</span>\n      <span>ゲーム</span><span>工芸</span><span>ファッションデザイン</span><span>先端芸術表現</span>\n    </div>\n  </div>\n</section>",
  "s4": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head\"><span class=\"eyebrow\">ROSTER</span><h2 class=\"section__title\">合格者名簿（抜粋）</h2><p class=\"section__lead\">合格名簿の一部です。氏名は姓のみ・伏せ字で掲載しています。</p></div>\n    <div style=\"overflow-x:auto;\">\n    <table class=\"roster\">\n      <thead><tr><th>合格大学</th><th>専攻</th><th>課程</th><th>合格者</th></tr></thead>\n      <tbody>\n        <tr><td>東京藝術大学</td><td>先端芸術表現</td><td class=\"lv\">大学院</td><td>何さん</td></tr>\n        <tr><td>東京藝術大学</td><td>映像研究</td><td class=\"lv\">大学院</td><td>韋さん</td></tr>\n        <tr><td>多摩美術大学</td><td>グラフィックデザイン</td><td class=\"lv\">学部</td><td>徐さん</td></tr>\n        <tr><td>多摩美術大学</td><td>油画</td><td class=\"lv\">学部</td><td>彭さん</td></tr>\n        <tr><td>多摩美術大学</td><td>キャラクターデザイン</td><td class=\"lv\">大学院</td><td>黄さん</td></tr>\n        <tr><td>武蔵野美術大学</td><td>映像・写真</td><td class=\"lv\">大学院</td><td>陸さん</td></tr>\n        <tr><td>武蔵野美術大学</td><td>彫刻</td><td class=\"lv\">学部</td><td>劉さん</td></tr>\n        <tr><td>武蔵野美術大学</td><td>油画</td><td class=\"lv\">学部</td><td>朱さん</td></tr>\n        <tr><td>女子美術大学</td><td>工芸</td><td class=\"lv\">学部</td><td>姜さん</td></tr>\n        <tr><td>女子美術大学</td><td>立体芸術</td><td class=\"lv\">大学院</td><td>郭さん</td></tr>\n        <tr><td>東京造形大学</td><td>プロダクトデザイン</td><td class=\"lv\">大学院</td><td>謝さん</td></tr>\n        <tr><td>日本大学 芸術学部</td><td>アニメーション</td><td class=\"lv\">大学院</td><td>楊さん</td></tr>\n        <tr><td>京都精華大学</td><td>漫画</td><td class=\"lv\">大学院</td><td>邵さん</td></tr>\n        <tr><td>京都精華大学</td><td>キャラクターデザイン</td><td class=\"lv\">学部</td><td>毛さん</td></tr>\n        <tr><td>京都芸術大学</td><td>イラストレーション</td><td class=\"lv\">大学院</td><td>刑さん</td></tr>\n        <tr><td>京都芸術大学</td><td>写真</td><td class=\"lv\">大学院</td><td>曹さん</td></tr>\n        <tr><td>大阪芸術大学</td><td>キャラクター造形</td><td class=\"lv\">学部</td><td>夏さん</td></tr>\n        <tr><td>成安造形大学</td><td>イラストレーション</td><td class=\"lv\">学部</td><td>盧さん</td></tr>\n        <tr><td>東京工芸大学</td><td>ゲーム</td><td class=\"lv\">学部</td><td>張さん</td></tr>\n        <tr><td>文化服装学院 BFGU</td><td>ファッションデザイン</td><td class=\"lv\">大学院</td><td>陳さん</td></tr>\n      </tbody>\n    </table>\n    </div>\n    <p style=\"font-size:12px;color:var(--faint);margin-top:14px;text-align:center;\">※ 合格名簿のごく一部です。詳細・最新の実績は個別にご提供します。</p>\n  </div>\n</section>",
  "s5": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow\">CHINICHI JUKU</span><h2 class=\"section__title\">知日塾 文理 合格実績</h2><p class=\"section__lead\">累計 1,506名（学部）・1,023名（大学院）が合格。旧帝・早慶上理・MARCH・関関同立まで。</p></div>\n    <div class=\"uni-tiers\">\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">国公立</span><div class=\"uni-tier__c\"><span>大阪大学</span><span>東北大学</span><span>筑波大学</span><span>東京都立大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">早慶上理</span><div class=\"uni-tier__c\"><span>早稲田大学</span><span>慶應義塾大学</span><span>上智大学</span><span>東京理科大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">MARCH</span><div class=\"uni-tier__c\"><span>明治大学</span><span>立教大学</span><span>中央大学</span><span>法政大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">関関同立</span><div class=\"uni-tier__c\"><span>関西大学</span><span>関西学院大学</span><span>同志社大学</span><span>立命館大学</span></div></div>\n      <div class=\"uni-tier\"><span class=\"uni-tier__l\">ほか</span><div class=\"uni-tier__c\"><span>順天堂大学</span><span>日本大学</span><span>東洋大学</span><span>明治学院大学</span><span class=\"more-uni\">ほか多数</span></div></div>\n    </div>\n    <div class=\"cases\" style=\"margin-top:34px;\">\n      <div class=\"case\"><div class=\"case__meta\">文科｜7校合格</div><h3>専門学校から逆転、7つの合格を手に慶應義塾大学へ</h3><div class=\"case__offers\"><span>慶應義塾大学</span><span>立命館大学</span><span>同志社大学</span><span>立教大学</span><span>法政大学</span><span>関西大学</span><span>関西学院大学</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">理工｜社会人から再起</div><h3>上海の大学を休学し、2年で東京理科大学へ逆転合格</h3><div class=\"case__offers\"><span>東京理科大学</span><span>立命館大学</span><span>明治学院大学</span><span>法政大学</span><span>中央大学</span></div></div>\n    </div>\n  </div>\n</section>",

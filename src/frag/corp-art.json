 "source": "corporate/art.html",
 "sections": {
  "s1": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">TRACK RECORD</span><h2 class=\"section__title\">数字で見る、知日美術の合格力</h2><p class=\"section__lead\">2023〜2025年度、合格628枚。芸術系トップ校へ毎年合格者を輩出しています。</p></div>\n    <div class=\"stats\">\n      <div class=\"stat\"><div class=\"num\">628<small>枚</small></div><div class=\"lbl\">合格（2023〜2025年度）</div></div>\n      <div class=\"stat\"><div class=\"num\">96.3<small>%</small></div><div class=\"lbl\">学部 平均合格率</div></div>\n      <div class=\"stat\"><div class=\"num\">92.3<small>%</small></div><div class=\"lbl\">大学院 平均合格率</div></div>\n      <div class=\"stat\"><div class=\"num\">80<small>枚</small></div><div class=\"lbl\">トップ専門学校 合格</div></div>\n    </div>\n    <div class=\"flow__out\" style=\"max-width:760px;margin:34px auto 0;\">\n      内訳：<strong>東京御三家 77枚</strong>・<strong>東京五美 113枚</strong>・<strong>関西四美 199枚</strong>（※不完全統計）\n    </div>\n  </div>\n</section>",
  "s2": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">PORTFOLIO</span><h2 class=\"section__title\">作品で見る、指導の幅</h2><p class=\"section__lead\">日本画・絵画から服飾デザイン、ポートフォリオ、基礎デッサンまで。分野ごとの専門指導で「表現」を伸ばします。</p></div>\n    <div class=\"artwall\">\n      <figure><img src=\"/assets/img/photos/art-crane.jpg\" alt=\"日本画・絵画の作品例\" loading=\"lazy\"><figcaption>日本画・絵画<small>京都精華大学 合格者</small></figcaption></figure>\n      <figure><img src=\"/assets/img/photos/art-fashion.jpg\" alt=\"服飾デザインの作品例\" loading=\"lazy\"><figcaption>服飾デザイン<small>文化服装学院 BFGU 合格者</small></figcaption></figure>\n      <figure><img src=\"/assets/img/photos/acg-portfolio.jpg\" alt=\"ポートフォリオの作品例\" loading=\"lazy\"><figcaption>作品集（ポートフォリオ）<small>キャラクター・世界観設計</small></figcaption></figure>\n      <figure><img src=\"/assets/img/photos/acg-sketch.jpg\" alt=\"基礎デッサンの作品例\" loading=\"lazy\"><figcaption>基礎デッサン<small>構造・明暗・比例の基礎訓練</small></figcaption></figure>\n    </div>\n    <p class=\"art-note\">※ 在校生・修了生の作品より掲載しています（氏名は非掲載）。</p>\n  </div>\n</section>",
  "s3": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">BY SCHOOL</span><h2 class=\"section__title\">主な美大別 合格数</h2></div>\n    <div class=\"unicount\">\n      <div class=\"u\"><b>5<small>枚</small></b><span>東京藝術大学</span></div>\n      <div class=\"u\"><b>49<small>枚</small></b><span>多摩美術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>武蔵野美術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>女子美術大学</span></div>\n      <div class=\"u\"><b>11<small>枚</small></b><span>日本大学 芸術学部</span></div>\n      <div class=\"u\"><b>45<small>枚</small></b><span>京都精華大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>京都芸術大学</span></div>\n      <div class=\"u\"><b>23<small>枚</small></b><span>大阪芸術大学</span></div>\n      <div class=\"u\"><b>14<small>枚</small></b><span>成安造形大学</span></div>\n      <div class=\"u\"><b>7<small>枚</small></b><span>東京造形大学</span></div>\n    </div>\n  </div>\n</section>",
  "s4": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">FIELDS</span><h2 class=\"section__title\">17の専攻に対応</h2><p class=\"section__lead\">純芸術からデザイン・映像・服飾・ACGまで、志望専攻ごとの専門指導で合格へ導きます。</p></div>\n    <div class=\"brands\">\n      <span>イラストレーション</span><span>アニメーション</span><span>漫画</span><span>油画</span><span>彫刻</span>\n      <span>版画</span><span>グラフィックデザイン</span><span>プロダクトデザイン</span><span>ビジュアルデザイン</span>\n      <span>映像</span><span>写真</span><span>建築・空間デザイン</span><span>キャラクターデザイン</span>\n      <span>ゲーム</span><span>工芸</span><span>ファッションデザイン</span><span>先端芸術表現</span>\n    </div>\n  </div>\n</section>",
  "s5": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">EXAM</span><h2 class=\"section__title\">美大入試の2つの形式に対応</h2><p class=\"section__lead\">技法の完成度だけでなく「自分の考えを表現できるか」が問われる近年の入試。両形式に合わせて対策します。</p></div>\n    <div class=\"cards2\">\n      <div class=\"mini mini--c\"><h3>総合選抜（体験授業型）</h3><p>実際の授業に参加し、制作・討論・発表を通じて選考。学科の教育内容と雰囲気を体感しながら、表現力・思考力を総合的に評価されます。双方向の理解と適性を重視する入試方式です。</p></div>\n      <div class=\"mini mini--c\"><h3>外国人留学生入試</h3><p>素描実技＋作品集＋面接の3本柱。基礎デッサン、創作思考を形にする作品集づくり、専攻理解を整理する面接対策を、段階的に積み上げて本番に臨みます。</p></div>\n    </div>\n  </div>\n</section>",
  "s6": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section__head center\"><span class=\"eyebrow eyebrow--c\">VOICES</span><h2 class=\"section__title\">合格ストーリー</h2><p class=\"section__lead\">宣传册「美術 合格采访」の全インタビューです。純芸術・デザイン・建築・映像・服飾・キャラクターまで、合格者の歩みをご紹介します（氏名は非掲載）。</p></div>\n\n    <div class=\"section__head\" style=\"margin:0 auto 22px;max-width:none;\"><span class=\"eyebrow eyebrow--c\">美術大学院 ─ 修士・研究科</span></div>\n    <div class=\"cases\">\n      <div class=\"case\"><div class=\"case__meta\">プロダクト｜修士ダブル合格</div><h3>イタリアから日本へ、デザインの世界を追う</h3><div class=\"case__offers\"><span>東京造形大学 工業デザイン</span><span>京都芸術大学 プロダクト</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">建築｜第一志望合格</div><h3>第一志望の夢校を射止める</h3><div class=\"case__offers\"><span>武蔵野美術大学 建築専攻</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">デザイン情報｜事前面談で勝負</div><h3>事前面談を制すことが、合格への第一歩</h3><div class=\"case__offers\"><span>武蔵野美術大学 デザイン情報学専攻</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">映像｜最難関を半年で</div><h3>赴日半年で、日本美大の頂点・東京藝大へ</h3><div class=\"case__offers\"><span>東京藝術大学 映像研究科 映画制作</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">メディアデザイン｜海外大から</div><h3>パーソンズの服飾デザイナーが歩んだ、日本院試</h3><div class=\"case__offers\"><span>慶應義塾大学 メディアデザイン研究科（KMD）</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">先端芸術｜英国芸大から</div><h3>ロンドン芸大から藝大へ、フェミニズム創作</h3><div class=\"case__offers\"><span>東京藝術大学 先端芸術表現</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">油画｜ダブル合格</div><h3>欧州留学から日本へ、油画でダブル合格</h3><div class=\"case__offers\"><span>女子美術大学 洋画</span><span>日本大学 芸術学部</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">彫刻｜三合格</div><h3>「フェティッシュ」は、自己探求の武器</h3><div class=\"case__offers\"><span>多摩美術大学</span><span>武蔵野美術大学</span><span>京都市立芸術大学（彫刻）</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">漫画｜光速合格</div><h3>入塾10ヶ月で「光速」合格</h3><div class=\"case__offers\"><span>京都精華大学 漫画研究科</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">アニメ｜手作りで表現</div><h3>平面からアニメへ、手作り人形でアニメを制作</h3><div class=\"case__offers\"><span>京都精華大学 漫画研究科 アニメ方向</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">服飾｜伝統工芸で勝負</div><h3>伝統工芸で、BFGUの教授を動かす</h3><div class=\"case__offers\"><span>文化服装学院 BFGU 服飾デザイン</span><span>JLPT N2</span></div></div>\n    </div>\n\n    <div class=\"section__head\" style=\"margin:44px auto 22px;max-width:none;\"><span class=\"eyebrow eyebrow--c\">美術学部 ─ 学部</span></div>\n    <div class=\"cases\">\n      <div class=\"case\"><div class=\"case__meta\">日本画・イラスト｜ダブル合格</div><h3>体験のつもりが、まさかの合格</h3><div class=\"case__offers\"><span>京都芸術大学 日本画</span><span>イラスト</span><span>JLPT N2</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">イラスト｜練習から理想校へ</div><h3>練習の過程で、理想校を見つける</h3><div class=\"case__offers\"><span>東京工芸大学 芸術学部 イラスト方向</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">キャラクター｜奨学金獲得</div><h3>専攻を変えて、入学奨学金まで獲得</h3><div class=\"case__offers\"><span>京都芸術大学</span><span>大阪芸術大学（キャラクターデザイン）</span><span>EJU 290</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">版画・アニメ｜五美ダブル合格</div><h3>一般入試デッサン満点、五美ダブル合格</h3><div class=\"case__offers\"><span>多摩美術大学 版画</span><span>東京造形大学 アニメ</span><span>JLPT N1</span></div></div>\n      <div class=\"case\"><div class=\"case__meta\">漫画｜殿堂校へ</div><h3>国内大学を中退し、アニメ・漫画の殿堂校へ</h3><div class=\"case__offers\"><span>京都精華大学 漫画学部</span><span>EJU 310</span></div></div>\n    </div>\n  </div>\n</section>",
  "s7": "<section class=\"section section--alt\">\n  <div class=\"container\">\n    <div class=\"section__head\"><span class=\"eyebrow eyebrow--c\">ROSTER</span><h2 class=\"section__title\">合格者名簿（抜粋）</h2><p class=\"section__lead\">合格名簿の一部です。氏名は姓のみ・伏せ字で掲載しています。</p></div>\n    <div style=\"overflow-x:auto;\">\n    <table class=\"roster\">\n      <thead><tr><th>合格大学</th><th>専攻</th><th>課程</th><th>合格者</th></tr></thead>\n      <tbody>\n        <tr><td>東京藝術大学</td><td>先端芸術表現</td><td class=\"lv\">大学院</td><td>何さん</td></tr>\n        <tr><td>東京藝術大学</td><td>映像研究</td><td class=\"lv\">大学院</td><td>韋さん</td></tr>\n        <tr><td>多摩美術大学</td><td>グラフィックデザイン</td><td class=\"lv\">学部</td><td>徐さん</td></tr>\n        <tr><td>多摩美術大学</td><td>油画</td><td class=\"lv\">学部</td><td>彭さん</td></tr>\n        <tr><td>多摩美術大学</td><td>キャラクターデザイン</td><td class=\"lv\">大学院</td><td>黄さん</td></tr>\n        <tr><td>武蔵野美術大学</td><td>映像・写真</td><td class=\"lv\">大学院</td><td>陸さん</td></tr>\n        <tr><td>武蔵野美術大学</td><td>彫刻</td><td class=\"lv\">学部</td><td>劉さん</td></tr>\n        <tr><td>女子美術大学</td><td>工芸</td><td class=\"lv\">学部</td><td>姜さん</td></tr>\n        <tr><td>京都精華大学</td><td>漫画</td><td class=\"lv\">大学院</td><td>邵さん</td></tr>\n        <tr><td>京都精華大学</td><td>キャラクターデザイン</td><td class=\"lv\">学部</td><td>毛さん</td></tr>\n        <tr><td>京都芸術大学</td><td>イラストレーション</td><td class=\"lv\">大学院</td><td>刑さん</td></tr>\n        <tr><td>大阪芸術大学</td><td>キャラクター造形</td><td class=\"lv\">学部</td><td>夏さん</td></tr>\n        <tr><td>文化服装学院 BFGU</td><td>ファッションデザイン</td><td class=\"lv\">大学院</td><td>常さん</td></tr>\n        <tr><td>東京工芸大学</td><td>ゲーム</td><td class=\"lv\">学部</td><td>張さん</td></tr>\n      </tbody>\n    </table>\n    </div>\n    <p style=\"font-size:12px;color:var(--faint);margin-top:14px;text-align:center;\">※ 合格名簿のごく一部です。専攻別・年度別の詳細は個別にご提供します。 ／ <a href=\"/results/\" style=\"color:var(--cacc);font-weight:700;\">合格実績の全体を見る</a></p>\n  </div>\n</section>",
  "s8": "<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"xlink\">\n      <div>\n        <h3>アニメ・漫画・ゲーム志望の方へ</h3>\n        <p>ACG（Anime・Comic・Game）専門の学科方向・進路・カリキュラムを、専用ページで詳しくご紹介しています。</p>\n      </div>\n      <a href=\"/courses/acg/\" class=\"btn btn--white btn--lg\">ACG学部 専門ページへ</a>\n    </div>\n  </div>\n</section>",
  "s9": "<section class=\"cta-band\">\n  <div class=\"container\">\n    <h2>留学生の送り出し・採用をご検討の皆さまへ</h2>\n    <p>専攻別・年度別の詳細な合格実績は個別にご提供します。お気軽にご相談ください。</p>\n    <a href=\"/corporate/#contact\" class=\"btn btn--white btn--lg\">お問い合わせ・資料請求</a>\n  </div>\n</section>"
 },
